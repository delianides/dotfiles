{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,
  "actions": {
    "claude": {
      "command": "claude",
      "icon": {
        "path": "~/.config/cmux/icons/claude.svg",
        "type": "image"
      },
      "shortcut": [
        "ctrl+a",
        "shift+a"
      ],
      "target": "newTabInCurrentPane",
      "title": "Claude Code",
      "type": "command"
    },
    "codex": {
      "command": "codex",
      "icon": {
        "path": "~/.config/cmux/icons/codex.svg",
        "type": "image"
      },
      "target": "newTabInCurrentPane",
      "title": "Codex",
      "type": "command"
    },
    "default-layout": {
      "commandName": "New Workspace",
      "keywords": [
        "claude",
        "zmx",
        "default"
      ],
      "palette": true,
      "subtitle": "Claude in a persistent zmx session at the current directory",
      "title": "New Workspace",
      "type": "workspaceCommand"
    }
  },
  "automation": {
    "claudeBinaryPath": "$HOME/.local/bin/claude"
  },
  "commands": [],
  "ui": {
    "newWorkspace": {
      "action": "default-layout"
    },
    "surfaceTabBar": {
      "buttons": [
        {
          "builtin": "cmux.newTerminal",
          "id": "newTerminal"
        },
        {
          "builtin": "cmux.splitRight",
          "id": "splitRight"
        },
        {
          "builtin": "cmux.splitDown",
          "id": "splitDown"
        },
        {
          "builtin": "cmux.newBrowser",
          "id": "newBrowser"
        },
        {
          "action": "claude",
          "id": "claude"
        },
        {
          "action": "codex",
          "id": "codex"
        }
      ]
    }
  },
  "workspaceGroups": {
    "newWorkspacePlacement": "afterCurrent",
    "byCwd": {
      "~/Work/canary": {
        "color": "#006B6B",
        "icon": "folder.fill",
        "contextMenu": [
          {
            "action": "canary-thread",
            "title": "Open Claude (~/Work/canary)"
          },
          {
            "action": "default-layout",
            "title": "New Workspace"
          }
        ]
      }
    }
  },
  "diffViewer": {
    "defaultLayout": "unified"
  },
  "shortcuts": {
    "bindings": {
      "focusLeft": "cmd+ctrl+h",
      "focusDown": "cmd+ctrl+j",
      "focusUp": "cmd+ctrl+k",
      "focusRight": "cmd+ctrl+l",
      "openBrowser": "cmd+shift+o"
    }
  },
  "customSidebars": {
    "renderer": "inProcess"
  },
  "computerUse": {
    "enabled": false
  }
}
