shell-integration = zsh
theme = Catppuccin Mocha
font-size = 15

font-family = SauceCodePro Nerd Font Mono
background-blur-radius = 20
mouse-hide-while-typing = true
window-decoration = true
window-padding-x = 10
window-padding-y = 5
adjust-cell-height = 10

macos-option-as-alt = true

scrollback-limit = 1000000

window-save-state = always

# Window / pane / tab management — cmd-based so nothing competes with the
# multiplexer. cmux owns declarative workspace layouts; only keybindings here.
#
# IMPORTANT: ctrl+a and ctrl+hjkl are deliberately left unbound so they reach
# the multiplexer (herdr's prefix is ctrl+a; ctrl+hjkl is nvim-aware pane
# navigation). Ghostty consumes bound keys before the terminal program sees
# them, and `performable:` does not reliably fall through on macOS
# (ghostty-org/ghostty#9283, #5552), so unbinding is the only working fix.

# Splits / panes
# Create splits (cmux splitRight / splitDown). Ghostty's own split navigation
# stays on the cmd+alt+arrow and cmd+[ / cmd+] defaults.
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
# Zoom the focused split (cmux toggleSplitZoom).
keybind = cmd+shift+enter=toggle_split_zoom

# Tabs (cmux surfaces)
# New tab (cmux newSurface). cmd+shift+[ / cmd+shift+] cycle tabs, cmd+1..8
# jump to a tab, and cmd+9 → last tab are all Ghostty defaults.
keybind = cmd+t=new_tab

# Windows
keybind = cmd+n=new_window

# Misc
keybind = cmd+shift+k=clear_screen

keybind = global:cmd+;=toggle_quick_terminal

