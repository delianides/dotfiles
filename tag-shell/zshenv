export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_AUTO_UPDATE_SECS=604800
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_INSTALL_CLEANUP=1
export HOMEBREW_NO_ENV_HINTS=1
# Skip-list for file pickers lives in ~/.config/fzf/ignore (tag-shell/config/fzf/ignore).
export FZF_DEFAULT_COMMAND='rg --hidden --files --ignore-file ~/.config/fzf/ignore'
# Ctrl-T searches from the git root; --show-cdup yields e.g. `../../`, so the
# inserted paths stay valid from the current dir (and it falls back to `.` outside a repo).
export FZF_CTRL_T_COMMAND='rg --hidden --files --ignore-file ~/.config/fzf/ignore $(git rev-parse --show-cdup 2>/dev/null)'
export TIMEFMT=$'\nreal\t%*E\nuser\t%*U\nsys\t%*S'

export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"
export LC_CTYPE="en_US.UTF-8"

# brew shellenv (cached — refresh: rm ~/.cache/zsh-evals/brew.zsh)
if [[ ! -s ~/.cache/zsh-evals/brew.zsh || /opt/homebrew/bin/brew -nt ~/.cache/zsh-evals/brew.zsh ]]; then
  [[ -d ~/.cache/zsh-evals ]] || mkdir -p ~/.cache/zsh-evals
  /opt/homebrew/bin/brew shellenv > ~/.cache/zsh-evals/brew.zsh
fi
source ~/.cache/zsh-evals/brew.zsh

# keep $path/$PATH deduplicated so `exec zsh` reloads stay idempotent
typeset -U path PATH

export PATH="$HOME/.local/bin:$HOME/.bin:$HOME/.cargo/bin:$HOME/.lmstudio/bin:$PATH"
